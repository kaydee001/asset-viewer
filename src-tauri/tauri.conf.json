{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asset Viewer",
  "mainBinaryName": "asset-viewer",
  "version": "2.0.0",
  "identifier": "dev.assetviewer.viewer",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../hdri/": "hdri/"
    },
    "fileAssociations": [
      {
        "ext": ["glb", "gltf", "fbx", "obj", "stl", "ply", "3mf"],
        "name": "AssetViewer.Model",
        "description": "3D model",
        "role": "Viewer"
      }
    ]
  }
}
