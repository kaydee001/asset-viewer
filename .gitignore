#node / tauri (src-tauri/.gitignore covers target/)
node_modules/

#secrets and local notes
.env
.env.*
info.txt

#editor / os
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log

#hdris (the folder stays: tauri.conf.json bundles hdri/ as a resource, so it must exist on a fresh clone)
/hdri/*
!/hdri/.gitkeep

#meshes (samples/ is for the small test models that are committed on purpose)
*.gltf
*.glb
*.fbx
*.obj
*.mtl
*.stl
*.ply
*.3mf
!/samples/**

#builds (root only: web/static/vendor/three/build/ must stay tracked)
/dist/
/build/

#local folders
/models/
backup/
/linkedin/
